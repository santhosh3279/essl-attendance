[Unit]
Description=ESSL Attendance
Documentation=file:///home/erpdev/Attandance/README.md
# The terminals live on the LAN, so wait for a routable address before the
# first poll — otherwise every boot logs three failed device syncs.
Wants=network-online.target
After=network-online.target
# Default is 5 starts in 10s then a permanent failed state. That is the opposite
# of "always comes back", so retry forever instead. Belongs in [Unit], not [Service].
StartLimitIntervalSec=0

[Service]
Type=simple
User=__USER__
Group=__GROUP__
WorkingDirectory=__APP_DIR__
Environment=NODE_ENV=production
# Absolute node path: systemd has no PATH, and this node lives under nvm.
# An nvm upgrade deletes this directory — re-run scripts/install-service.sh after one.
ExecStart=__NODE_BIN__ --env-file-if-exists=__APP_DIR__/.env.production __APP_DIR__/src/index.js

Restart=always
RestartSec=5

StandardOutput=journal
StandardError=journal
SyslogIdentifier=attendance

NoNewPrivileges=yes
# Do NOT add ProtectHome= — the app and its database live under /home/erpdev
# and the service would fail to start.

[Install]
WantedBy=multi-user.target
