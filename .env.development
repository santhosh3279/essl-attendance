# Development. Loaded by `npm run dev`. Standalone — nothing else is merged in.

NODE_ENV=development

# Loopback only: dev never listens on the LAN.
HOST=127.0.0.1
PORT=3000

# Separate database, so `npm run seed:demo` can never touch production data.
DB_PATH=./data/dev.db

# Poll fast while developing.
POLL_INTERVAL_MINUTES=2
DEVICE_TIMEOUT_SECONDS=10

WORKDAY_START=09:00
WORKDAY_END=18:00
DUPLICATE_PUNCH_WINDOW_MINUTES=1
