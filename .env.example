# Reference for every supported key.
#
# The app does NOT read this file. Edit .env.development (used by `npm run dev`)
# or .env.production (used by `npm start` and the systemd service) instead —
# they are standalone, nothing is merged between them.

# development | production. Only affects logging and /api/health.
NODE_ENV=development

# HTTP port for the web UI
PORT=3000

# Bind address. 127.0.0.1 = local only. 0.0.0.0 = reachable on the LAN.
HOST=127.0.0.1

# SQLite file location. Relative paths resolve against the working directory —
# use an absolute path in production.
DB_PATH=./data/attendance.db

# Minutes between automatic device polls (0 disables the scheduler)
POLL_INTERVAL_MINUTES=10

# Seconds to wait before a device socket is considered dead
DEVICE_TIMEOUT_SECONDS=10

# Work-day boundaries used by the attendance grid
WORKDAY_START=09:00
WORKDAY_END=18:00

# Minutes between two punches of the same employee that are treated as duplicates
DUPLICATE_PUNCH_WINDOW_MINUTES=1
