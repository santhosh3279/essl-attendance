# Production. Loaded by `npm start` and by the systemd service.
# Standalone — nothing else is merged in.

NODE_ENV=production

# 0.0.0.0 = reachable from the LAN. The app has NO authentication:
# keep this on a trusted network, never port-forward it.
HOST=0.0.0.0
PORT=3000

# Absolute: systemd sets WorkingDirectory, but a relative path here would
# silently create an empty database somewhere else if that ever changed.
DB_PATH=/home/erpdev/Attandance/data/attendance.db

POLL_INTERVAL_MINUTES=10
DEVICE_TIMEOUT_SECONDS=10

WORKDAY_START=09:00
WORKDAY_END=18:00
DUPLICATE_PUNCH_WINDOW_MINUTES=1
